# ---------------------------------------------------------------------------
# Copy this file to `.env` (which is git-ignored) and fill in real values.
# NEVER commit real secrets here — this file is public.
# ---------------------------------------------------------------------------

# Frontend calls this server-side proxy; never put an OpenAI secret in Vite.
VITE_OPENAI_PROXY_URL=http://localhost:8787/api/chat
# Optional: real-time streaming endpoint. Falls back to VITE_OPENAI_PROXY_URL
# with `/stream` appended when unset.
VITE_OPENAI_STREAM_URL=http://localhost:8787/api/chat/stream

# Server-side only. Configure these in your local shell or hosting secrets.
# Rotate any key that was ever committed to git.
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
OPENAI_API_KEY_4=
OPENAI_API_KEY_5=
OPENAI_MODEL=gpt-4o-mini
OPENAI_PROXY_PORT=8787
OPENAI_PROXY_ORIGIN=http://localhost:5173

# Google Maps Platform key (enable Maps JavaScript API + Places API + Geocoding API).
# Use a browser-restricted key for the frontend, and a server key for the proxy.
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Existing Internet Computer configuration.
DFX_NETWORK=
II_URL=
